rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function validPublicationId(publicationId) {
      return publicationId.matches('[A-Za-z0-9]{20}');
    }

    function validImage(fileName) {
      return (
          fileName.matches('foto_[0-3]\\.(jpg|jpeg)')
          && request.resource.contentType == 'image/jpeg'
        ) || (
          fileName.matches('foto_[0-3]\\.png')
          && request.resource.contentType == 'image/png'
        ) || (
          fileName.matches('foto_[0-3]\\.webp')
          && request.resource.contentType == 'image/webp'
        ) || (
          fileName.matches('foto_[0-3]\\.heic')
          && request.resource.contentType == 'image/heic'
        ) || (
          fileName.matches('foto_[0-3]\\.heif')
          && request.resource.contentType == 'image/heif'
        );
    }

    function validEvidence(fileName) {
      return (
          fileName.matches('evidencia\\.(jpg|jpeg)')
          && request.resource.contentType == 'image/jpeg'
        ) || (
          fileName.matches('evidencia\\.png')
          && request.resource.contentType == 'image/png'
        ) || (
          fileName.matches('evidencia\\.webp')
          && request.resource.contentType == 'image/webp'
        ) || (
          fileName.matches('evidencia\\.heic')
          && request.resource.contentType == 'image/heic'
        ) || (
          fileName.matches('evidencia\\.heif')
          && request.resource.contentType == 'image/heif'
        );
    }

    // Consulta Firestore desde Storage: la cuenta de servicio de Storage
    // necesita el rol firebaserules.firestoreServiceAgent. La CLI solo lo
    // comprueba y concede al subir una versión nueva de este archivo y con un
    // TTY (o `--interactive`). Sin él, toda subida de evidencia se deniega
    // aunque la regla sea correcta.
    function canUploadEvidence(publicationId, actorId) {
      let publication = firestore.get(
        /databases/(default)/documents/publicaciones/$(publicationId)
      ).data;
      return request.auth.uid == actorId
        && publication.mode == 'donacion'
        && (
          (publication.deliveryType == 'voluntario'
            && publication.status == 'recogida'
            && publication.volunteerId == actorId)
          || (publication.deliveryType == 'donante'
            && publication.status == 'publicada'
            && publication.authorId == actorId)
        );
    }

    function isOrganization(organizationId) {
      return request.auth != null
        && request.auth.uid == organizationId
        && firestore.get(
          /databases/(default)/documents/usuarios/$(organizationId)
        ).data.rol == 'organizacion';
    }

    function validCampaignCover(fileName) {
      return (
          fileName.matches('cover\\.(jpg|jpeg)')
          && request.resource.contentType == 'image/jpeg'
        ) || (
          fileName == 'cover.png'
          && request.resource.contentType == 'image/png'
        ) || (
          fileName == 'cover.webp'
          && request.resource.contentType == 'image/webp'
        ) || (
          fileName == 'cover.heic'
          && request.resource.contentType == 'image/heic'
        ) || (
          fileName == 'cover.heif'
          && request.resource.contentType == 'image/heif'
        );
    }

    function campaignImageIsEditable(campaignId, organizationId) {
      let path = /databases/(default)/documents/campanias/$(campaignId);
      return !firestore.exists(path) || (
        firestore.get(path).data.organizationId == organizationId
        && firestore.get(path).data.status == 'active'
        && request.time < firestore.get(path).data.closeAt
      );
    }

    match /publicaciones/{authorId}/{publicationId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == authorId
        && resource == null
        && validPublicationId(publicationId)
        && validImage(fileName)
        && request.resource.size < 10 * 1024 * 1024;
      allow update: if false;
      // Permite la limpieza tras un fallo, limitada al namespace y a los
      // nombres válidos del propio usuario.
      allow delete: if request.auth != null
        && request.auth.uid == authorId
        && validPublicationId(publicationId)
        && fileName.matches('foto_[0-3]\\.(jpg|jpeg|png|webp|heic|heif)');
    }

    // Foto de perfil (HU20-9). Siempre JPEG porque la app la recomprime antes
    // de subirla; se admite sobrescribir para cambiarla sin acumular archivos.
    match /perfiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && fileName == 'avatar.jpg'
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && fileName == 'avatar.jpg';
    }

    // Reutiliza la dependencia Firestore ya requerida por evidencias. La
    // comprobación de rol es imprescindible: uid en la ruta, por sí solo, no
    // distingue una organización habilitada de una cuenta normal.
    match /campanias/{campaignId}/{organizationId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isOrganization(organizationId)
        && campaignId.matches('[A-Za-z0-9]{20}')
        && validCampaignCover(fileName)
        && request.resource.size < 10 * 1024 * 1024
        && campaignImageIsEditable(campaignId, organizationId);
      allow delete: if isOrganization(organizationId)
        && campaignId.matches('[A-Za-z0-9]{20}')
        && fileName.matches('cover\\.(jpg|jpeg|png|webp|heic|heif)')
        && campaignImageIsEditable(campaignId, organizationId);
    }

    match /entregas/{publicationId}/{actorId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && resource == null
        && validPublicationId(publicationId)
        && validEvidence(fileName)
        && request.resource.size < 10 * 1024 * 1024
        && canUploadEvidence(publicationId, actorId);
      allow update, delete: if false;
    }
  }
}
