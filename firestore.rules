rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // El administrador se reconoce por el campo `rol` de su documento de
    // usuario, que se asigna desde el backend (D06, D16). Cuesta una lectura
    // por evaluación, así que va siempre como última rama de cada regla: las
    // de usuario se resuelven antes y nunca la pagan.
    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == 'administrador';
    }

    function isCajamarcaDistrict(value) {
      return value in [
        'Cajamarca',
        'Asunción',
        'Chetilla',
        'Cospán',
        'La Encañada',
        'Jesús',
        'Llacanora',
        'Los Baños del Inca',
        'Magdalena',
        'Matara',
        'Namora',
        'San Juan'
      ];
    }

    // Nombres y apellidos van separados para derivar el nombre abreviado
    // (nombre de pila e inicial del primer apellido, HU20-13) sin adivinar
    // dónde termina el nombre. nombreCompleto se conserva para mostrarlo.
    // Los apellidos pueden faltar: Google entrega el nombre en una cadena y
    // puede traer una sola palabra.
    function validUserNames(user) {
      return user.nombres is string
        && user.nombres.size() > 0
        && user.nombres.size() <= 60
        && user.apellidos is string
        && user.apellidos.size() <= 60
        && user.nombreCompleto == (
          user.apellidos == ''
            ? user.nombres
            : user.nombres + ' ' + user.apellidos
        );
    }

    function validInitialUser() {
      return validInitialUserData(request.resource.data);
    }

    function validInitialUserData(user) {
      return user.keys().hasAll([
          'nombreCompleto',
          'correo',
          'rol',
          'nombres',
          'apellidos'
        ])
        && user.keys().hasOnly([
          'nombreCompleto',
          'correo',
          'rol',
          'nombres',
          'apellidos'
        ])
        && validUserNames(user)
        && user.correo is string
        && user.rol == 'usuario';
    }

    function validInitialUserAfter(userId) {
      let user = getAfter(
        /databases/$(database)/documents/usuarios/$(userId)
      ).data;
      return !exists(
          /databases/$(database)/documents/usuarios/$(userId)
        )
        && validInitialUserData(user);
    }

    // El dueño edita solo su nombre (HU20-9); correo y rol quedan fijos
    // (HU20-10, D06).
    function validUserEdit() {
      let after = request.resource.data;
      return after.keys().hasAll([
          'nombreCompleto',
          'correo',
          'rol',
          'nombres',
          'apellidos'
        ])
        && after.keys().hasOnly([
          'nombreCompleto',
          'correo',
          'rol',
          'nombres',
          'apellidos'
        ])
        && validUserNames(after)
        && after.correo == resource.data.correo
        && after.rol == resource.data.rol;
    }

    // El dueño edita nombre corto, distrito y foto (HU20-9); la fecha de
    // ingreso y los contadores no se tocan.
    function validProfileEdit() {
      let after = request.resource.data;
      return after.keys().hasAll([
          'nombreCorto',
          'distrito',
          'fechaIngreso',
          'contadores'
        ])
        && after.keys().hasOnly([
          'nombreCorto',
          'distrito',
          'fechaIngreso',
          'contadores',
          'fotoUrl'
        ])
        && after.nombreCorto is string
        && after.nombreCorto.size() > 0
        && after.nombreCorto.size() <= 60
        && after.distrito is string
        && (after.distrito == '' || isCajamarcaDistrict(after.distrito))
        && after.fechaIngreso == resource.data.fechaIngreso
        && after.contadores == resource.data.contadores
        && (
          !('fotoUrl' in after)
          || after.fotoUrl == null
          || (after.fotoUrl is string && after.fotoUrl.size() > 0)
        );
    }

    function validInitialProfile() {
      return request.resource.data.keys().hasAll([
          'nombreCorto',
          'distrito',
          'fechaIngreso',
          'contadores'
        ])
        && request.resource.data.keys().hasOnly([
          'nombreCorto',
          'distrito',
          'fechaIngreso',
          'contadores'
        ])
        && request.resource.data.nombreCorto is string
        && request.resource.data.nombreCorto.size() > 0
        && request.resource.data.distrito is string
        && request.resource.data.fechaIngreso == request.time
        && request.resource.data.contadores is map
        && request.resource.data.contadores.keys().hasAll([
          'donaciones',
          'intercambios',
          'voluntariados'
        ])
        && request.resource.data.contadores.keys().hasOnly([
          'donaciones',
          'intercambios',
          'voluntariados'
        ])
        && request.resource.data.contadores.donaciones == 0
        && request.resource.data.contadores.intercambios == 0
        && request.resource.data.contadores.voluntariados == 0;
    }

    function validPublicationImages() {
      let images = request.resource.data.images;
      let count = images.size();
      return images is list
        && count >= 1
        && count <= 4
        && images[0] is string
        && (count < 2 || images[1] is string)
        && (count < 3 || images[2] is string)
        && (count < 4 || images[3] is string);
    }

    function validInitialPublication() {
      return request.resource.data.keys().hasAll([
          'authorId',
          'title',
          'category',
          'condition',
          'description',
          'details',
          'district',
          'mode',
          'deliveryType',
          'status',
          'images',
          'publishedAt',
          'statusDates'
        ])
        && request.resource.data.keys().hasOnly([
          'authorId',
          'title',
          'category',
          'condition',
          'description',
          'details',
          'district',
          'mode',
          'deliveryType',
          'status',
          'images',
          'publishedAt',
          'statusDates'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.condition is string
        && request.resource.data.condition.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.details is list
        && request.resource.data.details.size() <= 6
        && request.resource.data.district is string
        && request.resource.data.district.size() > 0
        && request.resource.data.mode in ['donacion', 'intercambio']
        && request.resource.data.status == 'publicada'
        && request.resource.data.publishedAt == request.time
        && request.resource.data.statusDates is map
        && request.resource.data.statusDates.keys().hasAll(['publicada'])
        && request.resource.data.statusDates.keys().hasOnly(['publicada'])
        && request.resource.data.statusDates.publicada == request.time
        && validPublicationImages()
        && (
          (request.resource.data.mode == 'donacion'
            && request.resource.data.deliveryType in ['donante', 'voluntario'])
          || (request.resource.data.mode == 'intercambio'
            && request.resource.data.deliveryType == null)
        );
    }

    function publicationAfter(publicationId) {
      return getAfter(
        /databases/$(database)/documents/publicaciones/$(publicationId)
      ).data;
    }

    function publicationBefore(publicationId) {
      return get(
        /databases/$(database)/documents/publicaciones/$(publicationId)
      ).data;
    }

    function validDeliveryEvidence(publicationId, actorId) {
      let evidence = request.resource.data.deliveryEvidence;
      return evidence is map
        && evidence.keys().hasAll([
          'recipientInitials',
          'district',
          'storagePath',
          'recordedAt'
        ])
        && evidence.keys().hasOnly([
          'recipientInitials',
          'district',
          'storagePath',
          'recordedAt'
        ])
        && evidence.recipientInitials is string
        && evidence.recipientInitials.size() > 0
        && evidence.recipientInitials.size() <= 12
        && isCajamarcaDistrict(evidence.district)
        && evidence.storagePath.matches(
          'entregas/' + publicationId + '/' + actorId
            + '/evidencia\\.(jpg|jpeg|png|webp|heic|heif)'
        )
        && evidence.recordedAt == request.time;
    }

    function validDonationPublicationTransition(publicationId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let datesChanged = request.resource.data.statusDates
        .diff(resource.data.statusDates).affectedKeys();
      let assume = resource.data.deliveryType == 'voluntario'
        && resource.data.status == 'publicada'
        && request.auth.uid != resource.data.authorId
        && request.resource.data.status == 'comprometida'
        && request.resource.data.volunteerId == request.auth.uid
        && request.resource.data.committedAt == request.time
        && request.resource.data.statusDates.comprometida == request.time
        && datesChanged.hasOnly(['comprometida'])
        && changed.hasOnly([
          'status', 'volunteerId', 'committedAt', 'statusDates'
        ]);
      let release = resource.data.deliveryType == 'voluntario'
        && resource.data.status == 'comprometida'
        && request.auth.uid in [
          resource.data.authorId,
          resource.data.volunteerId
        ]
        && request.resource.data.status == 'publicada'
        && !('volunteerId' in request.resource.data)
        && !('committedAt' in request.resource.data)
        && request.resource.data.statusDates == resource.data.statusDates
        && changed.hasOnly(['status', 'volunteerId', 'committedAt']);
      let pickedUp = resource.data.deliveryType == 'voluntario'
        && resource.data.status == 'comprometida'
        && request.auth.uid == resource.data.authorId
        && resource.data.volunteerId is string
        && request.resource.data.status == 'recogida'
        && request.resource.data.volunteerId == resource.data.volunteerId
        && request.resource.data.pickedUpAt == request.time
        && request.resource.data.statusDates.recogida == request.time
        && datesChanged.hasOnly(['recogida'])
        && changed.hasOnly(['status', 'pickedUpAt', 'statusDates']);
      let delivered = resource.data.deliveryType == 'voluntario'
        && resource.data.status == 'recogida'
        && request.auth.uid == resource.data.volunteerId
        && request.resource.data.status == 'entregada'
        && request.resource.data.deliveredAt == request.time
        && request.resource.data.statusDates.entregada == request.time
        && datesChanged.hasOnly(['entregada'])
        && validDeliveryEvidence(publicationId, request.auth.uid)
        && changed.hasOnly([
          'status', 'deliveredAt', 'statusDates', 'deliveryEvidence'
        ]);
      let closeConfirmed = resource.data.deliveryType == 'voluntario'
        && resource.data.status == 'entregada'
        && request.auth.uid == resource.data.authorId
        && request.resource.data.status == 'confirmada'
        && request.resource.data.statusDates.confirmada == request.time
        && datesChanged.hasOnly(['confirmada'])
        && request.time < resource.data.statusDates.entregada
          + duration.value(120, 'h')
        && changed.hasOnly(['status', 'statusDates']);
      let directDelivery = resource.data.deliveryType == 'donante'
        && resource.data.status == 'publicada'
        && request.auth.uid == resource.data.authorId
        && request.resource.data.status == 'confirmada'
        && request.resource.data.deliveredAt == request.time
        && request.resource.data.statusDates.confirmada == request.time
        && datesChanged.hasOnly(['confirmada'])
        && validDeliveryEvidence(publicationId, request.auth.uid)
        && changed.hasOnly([
          'status', 'deliveredAt', 'statusDates', 'deliveryEvidence'
        ]);
      return resource.data.mode == 'donacion'
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.deliveryType == resource.data.deliveryType
        && (assume || release || pickedUp || delivered || closeConfirmed
          || directDelivery);
    }

    // Retiro por moderación (HU19-10). Solo desde publicada o comprometida:
    // una vez que el bien cambió de manos el retiro ya no evita nada y dejaría
    // una entrega sin forma de cerrarse. Se conservan voluntario y contraparte
    // como historial; `retirada` saca la publicación del feed y del detalle.
    function validAdminRemoval() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let datesChanged = request.resource.data.statusDates
        .diff(resource.data.statusDates).affectedKeys();
      return resource.data.status in ['publicada', 'comprometida']
        && request.resource.data.status == 'retirada'
        && request.resource.data.statusDates.retirada == request.time
        && datesChanged.hasOnly(['retirada'])
        && changed.hasOnly(['status', 'statusDates']);
    }

    // La contraparte de un intercambio retirado vuelve a estar disponible
    // (HU19-16): su bien no es el reportado. Es el espejo de `release` en
    // las donaciones, y exige que la propuesta quede cancelada en el mismo
    // lote.
    function validAdminExchangeRelease() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let proposal = proposalAfter(resource.data.exchangeProposalId);
      return resource.data.mode == 'intercambio'
        && resource.data.status == 'comprometida'
        && request.resource.data.status == 'publicada'
        && !('exchangeProposalId' in request.resource.data)
        && !('counterpartPublicationId' in request.resource.data)
        && !('counterpartUserId' in request.resource.data)
        && !('committedAt' in request.resource.data)
        && request.resource.data.statusDates == resource.data.statusDates
        && proposal.status == 'cancelada'
        && changed.hasOnly([
          'status',
          'exchangeProposalId',
          'counterpartPublicationId',
          'counterpartUserId',
          'committedAt'
        ]);
    }

    // Una propuesta pendiente o aceptada se cancela solo cuando una de sus
    // publicaciones quedó retirada, en este lote o antes: la limpieza de las
    // propuestas pendientes corre después del retiro (D16).
    function validAdminProposalCancellation() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status in ['pendiente', 'aceptada']
        && request.resource.data.status == 'cancelada'
        && request.resource.data.cancelledAt == request.time
        && changed.hasOnly(['status', 'cancelledAt'])
        && (
          publicationAfter(resource.data.requestedPublicationId).status
            == 'retirada'
          || publicationAfter(resource.data.offeredPublicationId).status
            == 'retirada'
        );
    }

    // Sin compromiso no hay conversación (HU09-1): la otra parte tiene que ser
    // el voluntario del recojo o la contraparte del intercambio aceptado. Se
    // mira el estado posterior porque asumir el recojo crea la conversación en
    // la misma transacción.
    function committedCounterpart(publication, participants) {
      let other = participants[0] == publication.authorId
        ? participants[1]
        : participants[0];
      return publication.mode == 'donacion'
        ? publication.get('volunteerId', '') == other
        : publication.get('counterpartUserId', '') == other;
    }

    function validConversationCreate() {
      let publication = publicationAfter(request.resource.data.publicationId);
      let participants = request.resource.data.participantIds;
      return request.resource.data.keys().hasAll([
          'publicationId',
          'publicationTitle',
          'publicationImageUrl',
          'publicationMode',
          'participantIds',
          'createdAt',
          'updatedAt',
          'lastMessage',
          'lastSenderId',
          'lastMessageId'
        ])
        && request.resource.data.keys().hasOnly([
          'publicationId',
          'publicationTitle',
          'publicationImageUrl',
          'publicationMode',
          'participantIds',
          'createdAt',
          'updatedAt',
          'lastMessage',
          'lastSenderId',
          'lastMessageId'
        ])
        && request.resource.data.publicationId is string
        && request.resource.data.publicationTitle == publication.title
        && request.resource.data.publicationMode == publication.mode
        && request.resource.data.publicationImageUrl
          == publication.images[0]
        && participants is list
        && participants.size() == 2
        && participants[0] != participants[1]
        && request.auth.uid in participants
        && publication.authorId in participants
        && committedCounterpart(publication, participants)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastSenderId == null
        && request.resource.data.lastMessageId == null;
    }

    function validMessageCreate(conversationId, messageId) {
      let conversation = getAfter(
        /databases/$(database)/documents/conversaciones/$(conversationId)
      ).data;
      return request.resource.data.keys().hasAll([
          'conversationId',
          'publicationId',
          'senderId',
          'body',
          'queuedAt',
          'sentAt'
        ])
        && request.resource.data.keys().hasOnly([
          'conversationId',
          'publicationId',
          'senderId',
          'body',
          'queuedAt',
          'sentAt'
        ])
        && request.auth.uid in conversation.participantIds
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.conversationId == conversationId
        && request.resource.data.publicationId == conversation.publicationId
        && conversation.lastMessageId == messageId
        && conversation.lastSenderId == request.auth.uid
        && conversation.lastMessage == request.resource.data.body
        && conversation.updatedAt == request.time
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && request.resource.data.queuedAt is timestamp
        && request.resource.data.queuedAt <= request.time
        && request.resource.data.sentAt == request.time;
    }

    function validConversationMessageUpdate(conversationId) {
      let message = getAfter(
        /databases/$(database)/documents/conversaciones/$(conversationId)
          /mensajes/$(request.resource.data.lastMessageId)
      ).data;
      return request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage == message.body
        && message.senderId == request.auth.uid
        && message.conversationId == conversationId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessage', 'lastSenderId', 'lastMessageId'
        ]);
    }

    function proposalAfter(proposalId) {
      return getAfter(
        /databases/$(database)/documents/propuestasIntercambio/$(proposalId)
      ).data;
    }

    function proposalBefore(proposalId) {
      return get(
        /databases/$(database)/documents/propuestasIntercambio/$(proposalId)
      ).data;
    }

    function proposalExisted(proposalId) {
      return exists(
        /databases/$(database)/documents/propuestasIntercambio/$(proposalId)
      );
    }

    function publicationsHaveStatus(proposal, proposalId, status) {
      let requested = getAfter(
        /databases/$(database)/documents/publicaciones/$(proposal.requestedPublicationId)
      ).data;
      let offered = getAfter(
        /databases/$(database)/documents/publicaciones/$(proposal.offeredPublicationId)
      ).data;
      return requested.status == status
        && offered.status == status
        && requested.exchangeProposalId == proposalId
        && offered.exchangeProposalId == proposalId
        && requested.statusDates[status] == request.time
        && offered.statusDates[status] == request.time;
    }

    function validExchangePublicationTransition(publicationId) {
      let proposal = proposalAfter(request.resource.data.exchangeProposalId);
      let isParticipant = request.auth.uid in proposal.participantIds;
      let belongsToProposal = publicationId == proposal.requestedPublicationId
        || publicationId == proposal.offeredPublicationId;
      let validOwner = (
        publicationId == proposal.requestedPublicationId
        && resource.data.authorId == proposal.requestedOwnerId
      ) || (
        publicationId == proposal.offeredPublicationId
        && resource.data.authorId == proposal.offeredOwnerId
      );
      let validCounterpart = (
        publicationId == proposal.requestedPublicationId
        && request.resource.data.counterpartPublicationId
          == proposal.offeredPublicationId
        && request.resource.data.counterpartUserId == proposal.offeredOwnerId
      ) || (
        publicationId == proposal.offeredPublicationId
        && request.resource.data.counterpartPublicationId
          == proposal.requestedPublicationId
        && request.resource.data.counterpartUserId == proposal.requestedOwnerId
      );
      let accepted = proposal.status == 'aceptada';
      let confirmationCount =
        (proposal.requestedOwnerConfirmedAt is timestamp ? 1 : 0)
        + (proposal.offeredOwnerConfirmedAt is timestamp ? 1 : 0);
      let accepting = resource.data.status == 'publicada'
        && resource.data.mode == 'intercambio'
        && request.resource.data.status == 'comprometida'
        && request.resource.data.committedAt == request.time
        && request.resource.data.statusDates.comprometida == request.time
        && request.resource.data.statusDates.diff(resource.data.statusDates)
          .affectedKeys().hasOnly(['comprometida'])
        && validCounterpart
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'exchangeProposalId',
          'counterpartPublicationId',
          'counterpartUserId',
          'committedAt',
          'statusDates'
        ]);
      // La primera confirmación deja constancia de quién la hizo, así el
      // recorrido puede decir qué confirmación falta o faltó (HU07-15 y 19).
      let firstConfirmation = resource.data.status == 'comprometida'
        && request.resource.data.status == 'entregada'
        && request.resource.data.statusDates.entregada == request.time
        && request.resource.data.statusDates.diff(resource.data.statusDates)
          .affectedKeys().hasOnly(['entregada'])
        && request.resource.data.firstConfirmedBy == request.auth.uid
        && confirmationCount == 1
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'statusDates', 'firstConfirmedBy']);
      // Pasadas las 120 h desde la primera confirmación el cierre sin
      // confirmación es definitivo (HU07-19), como en HU13.
      let finalConfirmation = resource.data.status == 'entregada'
        && request.resource.data.status == 'confirmada'
        && request.resource.data.statusDates.confirmada == request.time
        && request.resource.data.statusDates.diff(resource.data.statusDates)
          .affectedKeys().hasOnly(['confirmada'])
        && request.time < resource.data.statusDates.entregada
          + duration.value(120, 'h')
        && confirmationCount == 2
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'statusDates']);
      return isParticipant
        && belongsToProposal
        && validOwner
        && accepted
        && (accepting || firstConfirmation || finalConfirmation);
    }

    function validInitialProposal() {
      return request.resource.data.keys().hasAll([
          'requestedPublicationId',
          'requestedPublicationTitle',
          'requestedOwnerId',
          'offeredPublicationId',
          'offeredPublicationTitle',
          'offeredOwnerId',
          'participantIds',
          'requestedImageUrl',
          'offeredImageUrl',
          'status',
          'proposedAt',
          'respondedAt',
          'requestedOwnerConfirmedAt',
          'offeredOwnerConfirmedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requestedPublicationId',
          'requestedPublicationTitle',
          'requestedOwnerId',
          'offeredPublicationId',
          'offeredPublicationTitle',
          'offeredOwnerId',
          'participantIds',
          'requestedImageUrl',
          'offeredImageUrl',
          'status',
          'proposedAt',
          'respondedAt',
          'requestedOwnerConfirmedAt',
          'offeredOwnerConfirmedAt'
        ])
        && request.resource.data.requestedPublicationId is string
        && request.resource.data.offeredPublicationId is string
        && request.resource.data.requestedPublicationId
          != request.resource.data.offeredPublicationId
        && request.resource.data.requestedPublicationTitle is string
        && request.resource.data.offeredPublicationTitle is string
        && request.resource.data.requestedOwnerId is string
        && request.resource.data.offeredOwnerId == request.auth.uid
        && request.resource.data.requestedOwnerId != request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds == [
          request.resource.data.requestedOwnerId,
          request.resource.data.offeredOwnerId
        ]
        && (request.resource.data.requestedImageUrl == null
          || request.resource.data.requestedImageUrl is string)
        && (request.resource.data.offeredImageUrl == null
          || request.resource.data.offeredImageUrl is string)
        && request.resource.data.status == 'pendiente'
        && request.resource.data.proposedAt == request.time
        && request.resource.data.respondedAt == null
        && request.resource.data.requestedOwnerConfirmedAt == null
        && request.resource.data.offeredOwnerConfirmedAt == null;
    }

    function validInitialReport() {
      // El comentario es opcional, pero el campo tiene que estar presente: la
      // aplicación lo escribe siempre, y la resolución del administrador no
      // tiene por qué distinguir "vacío" de "ausente".
      return request.resource.data.keys().hasAll([
          'publicationId',
          'reporterId',
          'reason',
          'comment',
          'status',
          'createdAt',
          'resolvedAt',
          'resolvedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'publicationId',
          'reporterId',
          'reason',
          'comment',
          'status',
          'createdAt',
          'resolvedAt',
          'resolvedBy'
        ])
        && request.resource.data.publicationId is string
        && request.resource.data.publicationId.size() > 0
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason in [
          'contenido_inapropiado',
          'bien_prohibido',
          'publicacion_enganosa',
          'solicitud_de_dinero',
          'otro'
        ]
        && (request.resource.data.comment == null
          || (request.resource.data.comment is string
            && request.resource.data.comment.size() <= 500))
        // "Pendiente" y sin resolución: quien reporta no decide el resultado
        // (HU19, criterios 9, 11 y 12).
        && request.resource.data.status == 'pendiente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null;
    }

    // Resolución del administrador (HU19-10 a 12). "Retirada" solo vale si la
    // publicación queda retirada en el mismo lote o ya lo estaba; así reporte y
    // publicación no pueden contradecirse. "Desestimado" no toca nada más.
    function validReportResolution() {
      let after = request.resource.data;
      return resource.data.status == 'pendiente'
        && after.status in ['desestimado', 'retirada']
        && after.resolvedAt == request.time
        && after.resolvedBy == request.auth.uid
        && after.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt', 'resolvedBy'])
        && (
          after.status == 'desestimado'
          || publicationAfter(resource.data.publicationId).status == 'retirada'
        );
    }

    function validNotificationSchema() {
      return request.resource.data.keys().hasAll([
          'recipientId',
          'type',
          'message',
          'publicationId',
          'createdAt',
          'read'
        ])
        && request.resource.data.keys().hasOnly([
          'recipientId',
          'type',
          'message',
          'proposalId',
          'publicationId',
          'conversationId',
          'messageId',
          'reportId',
          'actorId',
          'createdAt',
          'read'
        ])
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.type in [
          'propuesta_intercambio',
          'propuesta_rechazada',
          'propuesta_aceptada',
          'confirmacion_intercambio_pendiente',
          'intercambio_confirmado',
          'nuevo_mensaje',
          'recojo_asumido',
          'compromiso_liberado',
          'entrega_a_voluntario',
          'entrega_destinatario',
          'cierre_confirmado',
          'publicacion_retirada',
          'reporte_resuelto',
          'compromiso_cancelado'
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.publicationId is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false;
    }

    function validProposalCreatedNotification() {
      let proposalId = request.resource.data.proposalId;
      let after = proposalAfter(proposalId);
      let actor = request.auth.uid;
      let recipient = request.resource.data.recipientId;
      return !proposalExisted(proposalId)
        && after.status == 'pendiente'
        && actor == after.offeredOwnerId
        && recipient == after.requestedOwnerId
        && request.resource.data.type == 'propuesta_intercambio';
    }

    function validProposalResponseNotification() {
      let proposalId = request.resource.data.proposalId;
      let before = proposalBefore(proposalId);
      let after = proposalAfter(proposalId);
      let actor = request.auth.uid;
      let recipient = request.resource.data.recipientId;
      let rejected = before.status == 'pendiente'
        && after.status == 'rechazada'
        && actor == before.requestedOwnerId
        && recipient == before.offeredOwnerId
        && request.resource.data.type == 'propuesta_rechazada';
      let accepted = before.status == 'pendiente'
        && after.status == 'aceptada'
        && after.requestedOwnerConfirmedAt == null
        && after.offeredOwnerConfirmedAt == null
        && actor == before.requestedOwnerId
        && recipient == before.offeredOwnerId
        && request.resource.data.type == 'propuesta_aceptada';
      return proposalExisted(proposalId) && (rejected || accepted);
    }

    function validConfirmationNotification() {
      let proposalId = request.resource.data.proposalId;
      let before = proposalBefore(proposalId);
      let after = proposalAfter(proposalId);
      let actor = request.auth.uid;
      let recipient = request.resource.data.recipientId;
      let requestedOwnerConfirmed = before.status == 'aceptada'
        && actor == after.requestedOwnerId
        && recipient == after.offeredOwnerId
        && before.requestedOwnerConfirmedAt == null
        && after.requestedOwnerConfirmedAt == request.time
        && after.offeredOwnerConfirmedAt
          == before.offeredOwnerConfirmedAt;
      let offeredOwnerConfirmed = before.status == 'aceptada'
        && actor == after.offeredOwnerId
        && recipient == after.requestedOwnerId
        && before.offeredOwnerConfirmedAt == null
        && after.offeredOwnerConfirmedAt == request.time
        && after.requestedOwnerConfirmedAt
          == before.requestedOwnerConfirmedAt;
      let confirmationCount =
        (after.requestedOwnerConfirmedAt is timestamp ? 1 : 0)
        + (after.offeredOwnerConfirmedAt is timestamp ? 1 : 0);
      return proposalExisted(proposalId)
        && after.status == 'aceptada'
        && (requestedOwnerConfirmed || offeredOwnerConfirmed)
        && (
          (confirmationCount == 1
            && request.resource.data.type
              == 'confirmacion_intercambio_pendiente')
          || (confirmationCount == 2
            && request.resource.data.type == 'intercambio_confirmado')
        );
    }

    function validNotificationForProposal() {
      let after = proposalAfter(request.resource.data.proposalId);
      return request.auth.uid in after.participantIds
        && request.resource.data.recipientId in after.participantIds
        && request.resource.data.publicationId
          == after.requestedPublicationId
        && (
          validProposalCreatedNotification()
          || validProposalResponseNotification()
          || validConfirmationNotification()
        );
    }

    function validMessageNotification() {
      let conversationId = request.resource.data.conversationId;
      let messageId = request.resource.data.messageId;
      let conversation = getAfter(
        /databases/$(database)/documents/conversaciones/$(conversationId)
      ).data;
      let message = getAfter(
        /databases/$(database)/documents/conversaciones/$(conversationId)
          /mensajes/$(messageId)
      ).data;
      return request.resource.data.type == 'nuevo_mensaje'
        && request.auth.uid in conversation.participantIds
        && request.resource.data.recipientId in conversation.participantIds
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.publicationId == conversation.publicationId
        && message.senderId == request.auth.uid
        && message.conversationId == conversationId
        && message.publicationId == conversation.publicationId
        && message.sentAt == request.time;
    }

    function validDeliveryNotification() {
      let publicationId = request.resource.data.publicationId;
      let before = publicationBefore(publicationId);
      let after = publicationAfter(publicationId);
      let actor = request.auth.uid;
      let recipient = request.resource.data.recipientId;
      let assumed = request.resource.data.type == 'recojo_asumido'
        && before.status == 'publicada'
        && after.status == 'comprometida'
        && after.volunteerId == actor
        && actor != before.authorId
        && recipient == before.authorId;
      let released = request.resource.data.type == 'compromiso_liberado'
        && before.status == 'comprometida'
        && after.status == 'publicada'
        && actor in [before.authorId, before.volunteerId]
        && recipient in [before.authorId, before.volunteerId]
        && recipient != actor
        && !('volunteerId' in after);
      let pickedUp = request.resource.data.type == 'entrega_a_voluntario'
        && before.status == 'comprometida'
        && after.status == 'recogida'
        && actor == before.authorId
        && recipient == before.volunteerId;
      let delivered = request.resource.data.type == 'entrega_destinatario'
        && before.status == 'recogida'
        && after.status == 'entregada'
        && actor == before.volunteerId
        && recipient == before.authorId;
      let closed = request.resource.data.type == 'cierre_confirmado'
        && before.status == 'entregada'
        && after.status == 'confirmada'
        && actor == before.authorId
        && recipient == before.volunteerId;
      return request.resource.data.actorId == actor
        && before.mode == 'donacion'
        && (assumed || released || pickedUp || delivered || closed);
    }

    // Avisos de moderación (HU19-13, 14 y 16). Cada uno se ata al documento
    // que lo motiva con `getAfter`, así ni un administrador escribe un aviso
    // sin la resolución detrás.
    function validModerationNotification() {
      let data = request.resource.data;
      let publication = publicationAfter(data.publicationId);
      let withdrawn = data.type == 'publicacion_retirada'
        && publication.status == 'retirada'
        && data.recipientId == publication.authorId;
      let resolved = data.type == 'reporte_resuelto'
        && validResolvedReportNotification(data);
      let cancelled = data.type == 'compromiso_cancelado'
        && publication.status == 'retirada'
        && data.recipientId != publication.authorId
        && (
          'proposalId' in data
            ? validCancelledProposalNotification(data)
            : data.recipientId in [
                publication.get('volunteerId', ''),
                publication.get('counterpartUserId', '')
              ]
        );
      return isAdmin()
        && data.actorId == request.auth.uid
        && (withdrawn || resolved || cancelled);
    }

    function validResolvedReportNotification(data) {
      let report = getAfter(
        /databases/$(database)/documents/reportes/$(data.reportId)
      ).data;
      return report.status != 'pendiente'
        && report.resolvedBy == request.auth.uid
        && report.publicationId == data.publicationId
        && data.recipientId == report.reporterId;
    }

    function validCancelledProposalNotification(data) {
      let proposal = proposalAfter(data.proposalId);
      return proposal.status == 'cancelada'
        && data.recipientId in proposal.participantIds
        && data.publicationId in [
          proposal.requestedPublicationId,
          proposal.offeredPublicationId
        ];
    }

    function validNotificationOrigin() {
      return request.resource.data.type in [
          'propuesta_intercambio',
          'propuesta_rechazada',
          'propuesta_aceptada',
          'confirmacion_intercambio_pendiente',
          'intercambio_confirmado'
        ]
        ? validNotificationForProposal()
        : request.resource.data.type == 'nuevo_mensaje'
          ? validMessageNotification()
          : request.resource.data.type in [
              'publicacion_retirada',
              'reporte_resuelto',
              'compromiso_cancelado'
            ]
            ? validModerationNotification()
            : validDeliveryNotification();
    }

    match /usuarios/{userId} {
      // Nombre completo y correo son privados (D07); el público va en perfiles.
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validInitialUser();
      // Solo el nombre es editable; el rol se asigna desde el backend (D06).
      allow update: if signedIn()
        && request.auth.uid == userId
        && validUserEdit();
      allow delete: if false;
    }

    match /perfiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && validInitialProfile();
      // Edición del dueño, o la reparación atómica de AuthRepository cuando
      // falta el documento de usuario pero ya existe el perfil.
      allow update: if signedIn()
        && request.auth.uid == userId
        && (
          validProfileEdit()
          || (validInitialUserAfter(userId) && validInitialProfile())
        );
      allow delete: if false;
    }

    match /publicaciones/{publicationId} {
      // Anuladas y retiradas salen de la consulta pública (HU14-13): las ven
      // el autor, quien participó en la operación y la moderación. Las
      // consultas de terceros tienen que filtrar por estado para que la regla
      // sea demostrable.
      allow read: if signedIn() && (
        resource.data.status in [
          'publicada',
          'comprometida',
          'recogida',
          'entregada',
          'confirmada'
        ]
        || resource.data.authorId == request.auth.uid
        || resource.data.get('volunteerId', '') == request.auth.uid
        || resource.data.get('counterpartUserId', '') == request.auth.uid
        || isAdmin()
      );
      allow create: if signedIn() && validInitialPublication();
      allow update: if signedIn() && (
        (
          resource.data.authorId == request.auth.uid
          && resource.data.status == 'publicada'
          && request.resource.data.status == 'anulada'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        )
        || (
          'exchangeProposalId' in request.resource.data
          && validExchangePublicationTransition(publicationId)
        )
        || validDonationPublicationTransition(publicationId)
        || (
          isAdmin()
          && (validAdminRemoval() || validAdminExchangeRelease())
        )
      );
      allow delete: if false;
    }

    match /conversaciones/{conversationId} {
      // La app lee la conversación antes de crearla para no pisar una que ya
      // exista; si el documento no existe, `resource` es nulo y la lectura
      // debe pasar. El id no revela nada: se deriva de ids que ya se conocen.
      allow get: if signedIn()
        && (resource == null
          || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && validConversationCreate();
      allow update: if signedIn()
        && validConversationMessageUpdate(conversationId);
      allow delete: if false;

      match /mensajes/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversaciones/$(conversationId)
          ).data.participantIds;
        allow create: if signedIn()
          && validMessageCreate(conversationId, messageId);
        allow update, delete: if false;
      }
    }

    match /propuestasIntercambio/{proposalId} {
      // El administrador lee las propuestas de una publicación retirada para
      // cancelarlas (HU19-16).
      allow read: if signedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if signedIn()
        && validInitialProposal()
        && get(
          /databases/$(database)/documents/publicaciones/$(request.resource.data.offeredPublicationId)
        ).data.authorId == request.auth.uid
        && get(
          /databases/$(database)/documents/publicaciones/$(request.resource.data.offeredPublicationId)
        ).data.mode == 'intercambio'
        && get(
          /databases/$(database)/documents/publicaciones/$(request.resource.data.offeredPublicationId)
        ).data.status == 'publicada'
        && get(
          /databases/$(database)/documents/publicaciones/$(request.resource.data.requestedPublicationId)
        ).data.authorId == request.resource.data.requestedOwnerId
        && get(
          /databases/$(database)/documents/publicaciones/$(request.resource.data.requestedPublicationId)
        ).data.mode == 'intercambio'
        && get(
          /databases/$(database)/documents/publicaciones/$(request.resource.data.requestedPublicationId)
        ).data.status == 'publicada';
      allow update: if signedIn() && (
        (
          resource.data.status == 'pendiente'
          && request.auth.uid == resource.data.requestedOwnerId
          && request.resource.data.status == 'rechazada'
          && request.resource.data.respondedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'respondedAt'])
        )
        || (
          resource.data.status == 'pendiente'
          && request.auth.uid == resource.data.requestedOwnerId
          && request.resource.data.status == 'aceptada'
          && request.resource.data.respondedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'respondedAt'])
          && publicationsHaveStatus(
            request.resource.data,
            proposalId,
            'comprometida'
          )
        )
        || (
          resource.data.status == 'aceptada'
          && request.resource.data.status == 'aceptada'
          && request.auth.uid in resource.data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'requestedOwnerConfirmedAt',
            'offeredOwnerConfirmedAt'
          ])
          && (
            (request.auth.uid == resource.data.requestedOwnerId
              && resource.data.requestedOwnerConfirmedAt == null
              && request.resource.data.requestedOwnerConfirmedAt == request.time
              && request.resource.data.offeredOwnerConfirmedAt
                == resource.data.offeredOwnerConfirmedAt)
            || (request.auth.uid == resource.data.offeredOwnerId
              && resource.data.offeredOwnerConfirmedAt == null
              && request.resource.data.offeredOwnerConfirmedAt == request.time
              && request.resource.data.requestedOwnerConfirmedAt
                == resource.data.requestedOwnerConfirmedAt)
          )
          && publicationsHaveStatus(
            request.resource.data,
            proposalId,
            resource.data.requestedOwnerConfirmedAt == null
                && resource.data.offeredOwnerConfirmedAt == null
              ? 'entregada'
              : 'confirmada'
          )
          // La segunda confirmación solo dentro de las 120 h (HU07-19).
          && (
            (resource.data.requestedOwnerConfirmedAt == null
              && resource.data.offeredOwnerConfirmedAt == null)
            || request.time < publicationBefore(
                resource.data.requestedPublicationId
              ).statusDates.entregada + duration.value(120, 'h')
          )
        )
        || (isAdmin() && validAdminProposalCancellation())
      );
      allow delete: if false;
    }

    match /reportes/{reportId} {
      allow get: if signedIn()
        && (resource.data.reporterId == request.auth.uid || isAdmin());
      // El listado de pendientes es de la consola de moderación (HU19-8).
      allow list: if isAdmin();
      allow create: if signedIn()
        && validInitialReport()
        && reportId == request.resource.data.reporterId + '_' + request.resource.data.publicationId
        && !exists(/databases/$(database)/documents/reportes/$(reportId))
        && get(
          /databases/$(database)/documents/publicaciones/$(request.resource.data.publicationId)
        ).data.authorId != request.auth.uid;
      allow update: if isAdmin() && validReportResolution();
      allow delete: if false;
    }

    match /notificaciones/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn()
        && validNotificationSchema()
        && validNotificationOrigin();
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && resource.data.read == false
        && !('readAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'readAt'])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time;
      allow delete: if false;
    }
  }
}
